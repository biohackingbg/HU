// Health Upgrade — data model for user accounts and orders.
// Postgres (Neon, hosted on Vercel). Local dev and production share this
// database via DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  firstName    String?
  lastName     String?
  // customer | admin
  role         String    @default("customer")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  orders       Order[]
  addresses    Address[]
  reviews      Review[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  // Optional so guests can check out; set when a logged-in user orders.
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Guest/contact details
  email       String?
  phone       String?
  // processing | shipped | delivered | cancelled
  status      String      @default("processing")
  currency    String      @default("EUR")
  // cod | card
  paymentMethod String    @default("cod")
  // pending | paid
  paymentStatus String    @default("pending")
  paymentIntentId String? @unique
  // econt_address | econt_office | econt_machine
  shippingMethod String?
  // monetary values are stored in cents
  subtotal    Int
  shipping    Int         @default(0)
  total       Int
  // shipping snapshot
  shipName    String?
  shipLine1   String?
  shipCity    String?
  shipPostcode String?
  shipOffice  String?
  carrier     String?
  trackingNo  String?
  placedAt    DateTime    @default(now())
  items       OrderItem[]
  reviews     Review[]

  @@index([userId])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Stable product identifier (e.g. "neuromag-6") used to verify purchases.
  productSlug String  @default("")
  productName String
  variant     String?
  // cents
  unitPrice   Int
  quantity    Int
  imageUrl    String?

  @@index([productSlug])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String?
  fullName  String
  line1     String
  line2     String?
  city      String
  postcode  String
  country   String   @default("BG")
  phone     String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Product review. Only created for users with a matching delivered order,
/// so every review is a verified purchase.
model Review {
  id          String   @id @default(cuid())
  productSlug String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The order that proves the purchase.
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // 1–5
  rating      Int
  title       String?
  body        String
  // pending | approved | rejected
  status      String   @default("pending")
  // Admin note when rejecting (internal only).
  moderationNote String?
  helpfulCount Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // One review per product per customer.
  @@unique([userId, productSlug])
  @@index([productSlug, status])
}

/// Interest sign-ups for the (not yet launched) Blood testing service.
model BloodWaitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}
